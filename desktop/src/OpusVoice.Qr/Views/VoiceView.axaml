<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpusVoice.Qr.Views.VoiceView">

    <Grid ColumnDefinitions="6*,5*" ColumnSpacing="18" Margin="0,8,0,0">
        <!-- Left: controls -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">
            <TextBlock Grid.Row="0" Text="Voice · Opus 48 kHz mono" FontSize="16" FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <RadioButton x:Name="UdpRadio" GroupName="voiceTransport" IsChecked="True"
                                 Content="UDP" Click="OnTransportModeClicked" />
                    <RadioButton x:Name="PinholeRadio" GroupName="voiceTransport"
                                 Content="Pinhole / iroh (encrypted)" Click="OnTransportModeClicked" />
                </StackPanel>

                <TextBlock x:Name="UdpTargetLabel" Text="Target (fill from a scanned udp:// QR on the Scan tab)" FontSize="12"
                           Foreground="{DynamicResource OpusTextSecondaryBrush}" />
                <Grid x:Name="UdpTargetPanel" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" x:Name="HostBox" Watermark="host or [ipv6]" />
                    <TextBox Grid.Column="1" x:Name="PortBox" Width="110" Watermark="port" />
                </Grid>

                <TextBlock x:Name="PinholeTargetLabel" IsVisible="False" FontSize="12"
                           Foreground="{DynamicResource OpusTextSecondaryBrush}"
                           Text="Connection string (scan a pinhole QR on the Scan tab, or paste one from the receiver)" />
                <TextBox x:Name="TicketBox" IsVisible="False" Watermark="pinhole1:…"
                         TextWrapping="Wrap" MinHeight="52" AcceptsReturn="False" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="Source" FontSize="12" Foreground="{DynamicResource OpusTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <RadioButton x:Name="ToneRadio" GroupName="voiceSource" IsChecked="True"
                                 Content="Test tone (440 Hz)" />
                    <RadioButton x:Name="MicRadio" GroupName="voiceSource" Content="Microphone" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="6">
                <TextBlock Text="Bitrate" FontSize="12" Foreground="{DynamicResource OpusTextSecondaryBrush}" />
                <ComboBox x:Name="BitrateBox" Width="180" HorizontalAlignment="Left" SelectedIndex="2">
                    <ComboBoxItem Content="16 kbps" />
                    <ComboBoxItem Content="32 kbps" />
                    <ComboBoxItem Content="64 kbps" />
                    <ComboBoxItem Content="96 kbps" />
                    <ComboBoxItem Content="128 kbps" />
                </ComboBox>
            </StackPanel>

            <CheckBox Grid.Row="4" x:Name="LoopbackCheck" Content="Loopback monitor — decode and play back locally"
                      IsChecked="False" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <Button x:Name="StartButton" Classes="blurple" Content="Start streaming" Click="OnStartClicked" />
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="OnStopClicked" />
            </StackPanel>

            <!-- Pinhole listener: the receiving half — phone dials this machine's string -->
            <Border Grid.Row="6" Background="{DynamicResource OpusSurfaceBrush}" CornerRadius="12" Padding="12"
                    IsVisible="False" x:Name="ListenPanel">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="Listen over Pinhole — receive and play a peer's stream"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" x:Name="ListenTicketBox" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="monospace" MinHeight="52" Watermark="connection string appears here" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ListenStartButton" Classes="emerald" Content="Start listening" Click="OnListenStartClicked" />
                        <Button x:Name="ListenStopButton" Content="Stop" IsEnabled="False" Click="OnListenStopClicked" />
                        <Button x:Name="ListenCopyButton" Content="Copy string" IsEnabled="False" Click="OnListenCopyClicked" />
                        <Button x:Name="ListenQrButton" Content="Show QR" IsEnabled="False" Click="OnListenQrClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="7" x:Name="VoiceStatus" TextWrapping="Wrap" MinHeight="48"
                       Foreground="{DynamicResource OpusTextSecondaryBrush}"
                       Text="Pick a transport, a source and a target, then start. UDP streams plain RTP; Pinhole dials the ticket first (direct path, iroh relay fallback) and shows the live path while streaming. The test tone needs no microphone." />
        </Grid>

        <!-- Right: stats -->
        <Border Grid.Column="1" Background="{DynamicResource OpusSurfaceBrush}" CornerRadius="12" Padding="18">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <TextBlock Grid.Row="0" Text="Stream stats" FontSize="16" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock x:Name="StatsText" FontFamily="monospace" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource OpusTextSecondaryBrush}"
                               Text="idle" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
