<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Sibling checkout of Pinhole.Net by default; override with -p:PinholeRoot=… -->
    <PinholeRoot Condition="'$(PinholeRoot)' == ''">$(MSBuildThisFileDirectory)../../../Pinhole.Net</PinholeRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(PinholeRoot)/src/Pinhole/Pinhole.csproj" />
  </ItemGroup>

</Project>
